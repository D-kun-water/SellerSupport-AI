# Local single-merchant service. Bind to the loopback interface.
SELLERSUPPORT_DB=storage/sellersupport.sqlite3
SELLERSUPPORT_WORKBENCH_DB=storage/workbench.sqlite3
SELLERSUPPORT_VALIDATION_DB=storage/validation.sqlite3
# The normal application starts with an empty business database.
SELLERSUPPORT_SEED_MODE=empty
# Initial local identities; replace them when initializing merchant members.
SELLERSUPPORT_AGENT_TOKEN=
SELLERSUPPORT_SUPERVISOR_TOKEN=
# DeepSeek official API; fill the local .env only, never commit credentials.
DEEPSEEK_API_KEY=
SELLERSUPPORT_PROVIDER=deepseek
SELLERSUPPORT_MODEL=deepseek-flash
SELLERSUPPORT_BASE_URL=https://api.deepseek.com
# Offline evaluation works while this customer-workbench experiment is disabled.
SELLERSUPPORT_AI_ENABLED=false
# Automatic customer-message and Chinese-reply translation is independent of reply generation.
# It uses the same server key, budget and supervisor stop switch; no messages are sent.
SELLERSUPPORT_TRANSLATION_ENABLED=true
SELLERSUPPORT_EXPERIMENT_BUDGET_CNY=5.00
# Configured uncached peak-price estimates, not invoice reconciliation.
SELLERSUPPORT_INPUT_CNY_PER_MILLION=2.00
SELLERSUPPORT_OUTPUT_CNY_PER_MILLION=8.00
